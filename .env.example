# ===========================================================================
# Enterprise AI Knowledge Base -- example environment configuration
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed.
#
#     cp .env.example .env
#
# ===========================================================================

# ---------------------------------------------------------------------------
# Google Gemini
# ---------------------------------------------------------------------------
# Obtain a key from Google AI Studio and paste it into your local .env file.
# It is read by Spring AI as `spring.ai.google.genai.api-key`.
GEMINI_API_KEY=your-gemini-api-key-here

# Chat model used to generate grounded answers.
# Verified available in Spring AI 1.1.x: gemini-2.5-flash, gemini-2.5-pro,
# gemini-2.5-flash-lite, gemini-3-flash-preview, gemini-3-pro-preview
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Embedding model used to vectorise document chunks.
# Verified available: gemini-embedding-001, text-embedding-004
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Embedding vector width. gemini-embedding-001 defaults to 3072, but pgvector's
# HNSW index only supports up to 2000 dimensions, so we truncate to 768.
# This value MUST match EMBEDDING_DIMENSIONS below.
GEMINI_EMBEDDING_DIMENSIONS=768
EMBEDDING_DIMENSIONS=768

# ---------------------------------------------------------------------------
# PostgreSQL (with the pgvector extension)
# ---------------------------------------------------------------------------
POSTGRES_DB=knowledge_base
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Must be a Base64-encoded value of at least 32 bytes (256 bits) for HS256.
# Generate one locally, for example:
#     openssl rand -base64 48
JWT_SECRET=replace-with-a-locally-generated-base64-secret
JWT_EXPIRATION_MINUTES=120

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Directory where uploaded document files are stored on disk.
STORAGE_ROOT=./storage

# How uploaded documents reach the extraction/embedding pipeline.
#   IN_PROCESS - bounded in-memory queue, no broker required (default)
#   KAFKA      - publish an event; ingestion survives restarts and scales
#                independently, but requires the Kafka service to be running
INGESTION_MODE=IN_PROCESS

# Caching of generated answers in Redis. Off by default. When on, the cache key
# combines tenant, role, a per-tenant corpus version, and a hash of the question,
# so two tenants (or two roles) never share an entry.
ANSWER_CACHE_ENABLED=false
ANSWER_CACHE_TTL_MINUTES=10

# Per-user limit on AI questions, enforced in Redis across all instances.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AI_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# When true, audit logs retain the full text of AI questions and answers.
# Left false by default because company documents should not be duplicated
# into the audit table.
AUDIT_STORE_QUERY_TEXT=false

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
